{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Scan",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt",
            "cognito-idp:DescribeUserPool",
            "cognito-idp:GetUser",
            "cognito-idp:ListUsers",
            "cognito-idp:AdminCreateUser",
            "cognito-idp:AdminInitiateAuth",
            "cognito-idp:GetIdentityProviderByIdentifier",
            "cognito-idp:ListUserPools",
            "cognito-idp:ListUserPoolClients",
            "cognito-idp:AdminRespondToAuthChallenge"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy"
  },
  "api_handler-role": {
    "predefined_policies": [],
    "principal_service": "lambda",
    "custom_policies": [
      "lambda-basic-execution"
    ],
    "resource_type": "iam_role"
  },
  "simple-booking-userpool": {
    "resource_type": "cognito_idp",
    "password_policy": {
      "minimum_length": 8,
      "require_uppercase": false,
      "require_symbols": false,
      "require_lowercase": false,
      "require_numbers": false
    },
    "auto_verified_attributes": [],
    "sms_configuration": {},
    "username_attributes": [],
    "custom_attributes": [],
    "client": {
      "client_name": "client-app",
      "generate_secret": false,
      "explicit_auth_flows": [
        "ALLOW_ADMIN_USER_PASSWORD_AUTH",
        "ALLOW_CUSTOM_AUTH",
        "ALLOW_USER_SRP_AUTH",
        "ALLOW_REFRESH_TOKEN_AUTH"
      ]
    }
  },
  "api-ui-hoster": {
    "resource_type": "s3_bucket",
    "acl": "public-read",
    "location": "eu-central-1",
    "cors": [],
    "policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "PublicReadGetObject",
          "Effect": "Allow",
          "Principal": "*",
          "Action": [
            "s3:GetObject"
          ],
          "Resource": [
            "arn:aws:s3:::{bucket_name}/*"
          ]
        }
      ]
    },
    "public_access_block": {
      "block_public_acls": false,
      "ignore_public_acls": false,
      "block_public_policy": false,
      "restrict_public_buckets": false
    },
    "website_hosting": {
      "enabled": true,
      "index_document": "index.html",
      "error_document": "error.html"
    }
  },
  "Reservations": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": []
  },
  "Tables": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "N",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": []
  },
  "task10_api": {
  "resource_type": "api_gateway",
  "deploy_stage": "api",
  "authorizers": {
    "authorizer": {
      "type": "COGNITO_USER_POOLS",
      "identity_source": "method.request.header.Authorization",
      "user_pools": [
        "simple-booking-userpool"
      ],
      "ttl": 300
    }
  },
  "resources": {
    "/signup": {
      "enable_cors": true,
      "POST": {
        "authorization_type": "NONE",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      }
    },
    "/signin": {
      "enable_cors": true,
      "POST": {
        "authorization_type": "NONE",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      }
    },
    "/tables": {
      "enable_cors": true,
      "POST": {
        "authorization_type": "authorizer",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      },
      "GET": {
        "authorization_type": "authorizer",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      }
    },
    "/reservations": {
      "enable_cors": true,
      "POST": {
        "authorization_type": "authorizer",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      },
      "GET": {
        "authorization_type": "authorizer",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      }
    },
    "/tables/{tableId}": {
      "enable_cors": true,
      "GET": {
        "authorization_type": "authorizer",
        "integration_type": "lambda",
        "lambda_name": "api_handler",
        "enable_proxy": true
      }
    }
  },
  "minimum_compression_size": 0
}
}