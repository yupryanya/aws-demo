  "components": {
    "schemas": {
      "SignIn": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User's email address",
            "format": "email",
            "example": "johndoe@example.com"
          },
          "password": {
            "type": "string",
            "description": "User's password, must be alphanumeric and include any of \"$%^*\", and be at least 12 characters long",
            "example": "Password123$%"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignUp": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "User's first name",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "User's last name",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "description": "User's email address",
            "format": "email",
            "example": "johndoe@example.com"
          },
          "password": {
            "type": "string",
            "description": "User's password, must be alphanumeric and include any of \"$%^*\", and be at least 12 characters long",
            "example": "Password123$%"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "tableNumber": {
            "type": "integer",
            "description": "Number of the table",
            "example": 5
          },
          "clientName": {
            "type": "string",
            "description": "Name of the client",
            "example": "John Doe"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Client's phone number",
            "example": "+1234567890"
          },
          "date": {
            "type": "string",
            "description": "Date of the reservation in yyyy-MM-dd format",
            "example": "2024-08-15"
          },
          "slotTimeStart": {
            "type": "string",
            "description": "Reservation start time in HH:MM format",
            "example": "13:00"
          },
          "slotTimeEnd": {
            "type": "string",
            "description": "Reservation end time in HH:MM format",
            "example": "15:00"
          }
        },
        "required": [
          "tableNumber",
          "clientName",
          "phoneNumber",
          "date",
          "slotTimeStart",
          "slotTimeEnd"
        ]
      },
      "Table": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the table",
            "example": 2
          },
          "number": {
            "type": "integer",
            "description": "Number of the table",
            "example": 5
          },
          "places": {
            "type": "integer",
            "description": "Amount of people to sit at the table",
            "example": 4
          },
          "isVip": {
            "type": "boolean",
            "description": "Is the table in the VIP hall",
            "example": true
          },
          "minOrder": {
            "type": "integer",
            "description": "Table deposit required to book it",
            "nullable": true,
            "example": 100
          }
        },
        "required": [
          "id",
          "number",
          "places",
          "isVip"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The access token for subsequent authenticated requests",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
